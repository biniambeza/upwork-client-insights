{
  "manifest_version": 3,
  "name": "Upwork Client Insights",
  "version": "1.0.0",
  "description": "Adds client information to Upwork job cards.",
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/nx/find-work/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Upwork Client Insights"
  }
}