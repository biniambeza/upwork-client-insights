{
  "manifest_version": 3,
  "name": "Upwork Accelerator - Client Insights",
  "version": "1.1",
  "description": "Smart in-feed client analytics, hire rates, and spending history for Upwork freelancers.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.upwork.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.upwork.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Upwork Accelerator Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}